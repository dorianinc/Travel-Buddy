<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Travel Buddy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>

<body>
  <div class="nav-wrapper" style="{{#if home}}flex: 1.5{{else}}flex: 0{{/if}}">
    <div class="nav-top">
      <div class="nav-top-left" onclick="location.href='/'">
        <img id="logo" src="/images/travel-buddy-white.png" />
        <h2 id="app-name">TRAVEL BUDDY</h2>
      </div>
      <div class="nav-top-right">
        <ul class="nav-list">
          <span id="nav-basic-links">
            <li><a href="/plan">Plan a Trip</a></li>
            <li><a href="/itinerary">Itinerary</a></li>
          </span>
          <span id="nav-auth-links">
            <li class="nav-auth-link">
              <button onclick="location.href='login'" class="nav-button">Login</button>
            </li>
            <li class="nav-auth-link">
              <button onclick="location.href='sign-up'" class="nav-button">Sign Up</button>
            </li>
          </span>
        </ul>
      </div>
    </div>
    <div class="nav-bottom" style="{{#if home}}display: flex{{else}}display: none{{/if}}">
      <div>
        <h1 id="home-header">Find your perfect interary</h1>
        <input type="text" id="search-bar"></input></br>
        <button class="button-1 big">Discover Trips</button>
      </div>
    </div>
  </div>
  <div class="content-wrapper">
    {{{body}}}
  </div>
</body>

</html>