<div class="main-content home">
  <div id="home-destinations">
    <h1>Featured Destinations</h1>
    <div id="destination-cards">
        {{#each destinations}}
          <div class="destination-card">
            <img src="{{img}}" alt="{{cityName}}" />
            <h2>{{cityName}}</h2>
          </div>
        {{/each}}
    </div>
  </div>
</div>